<Window x:Class="KeganOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:comp="clr-namespace:KeganOS.Views.Components"
        Title="KeganOS" 
        Height="780" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        FontFamily="Consolas"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True">
    
    <Window.Resources>
        <!-- Window-specific resources can go here -->
    </Window.Resources>
    
    <Border BorderBrush="#333333" BorderThickness="1">
        <Grid x:Name="RootGrid" Background="Transparent" Focusable="True" MouseDown="RootGrid_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Custom Title Bar -->
                <RowDefinition Height="*"/>  <!-- Content -->
            </Grid.RowDefinitions>
            
            <!-- ═══ CUSTOM TITLE BAR ═══ -->
            <Grid Grid.Row="0" Background="#0D0D0D" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <TextBlock Text="KeganOS" Foreground="#555555" FontSize="11" 
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                
                <!-- Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"/>
                    <Button Content="□" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click"/>
                    <Button Content="✕" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF4444"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Width" Value="46"/>
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <TextBlock Text="{TemplateBinding Content}" 
                                                           Foreground="{TemplateBinding Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- ═══ MAIN CONTENT ═══ -->
            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="MainContentColumn"/>
                    <ColumnDefinition Width="Auto" x:Name="NexusColumn"/>
                </Grid.ColumnDefinitions>
                
                <!-- ═══ DASHBOARD AREA ═══ -->
                <Grid Grid.Column="0" x:Name="DashboardContainer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Quote -->
                        <RowDefinition Height="Auto"/> <!-- KEGOMODORO + Stats -->
                        <RowDefinition Height="*"/>    <!-- Journal -->
                        <RowDefinition Height="Auto"/> <!-- AI Chat Area (Placeholder) -->
                        <RowDefinition Height="Auto"/> <!-- Milestone -->
                    </Grid.RowDefinitions>
                    
                    <!-- ═══ TOP BAR ═══ -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Personal Symbol -->
                        <TextBlock Text="KAÆ[Æß#" Foreground="#888888" FontSize="14" VerticalAlignment="Center"
                                   x:Name="PersonalSymbol"/>
                        
                        <!-- User + Settings/Nexus -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Nexus Toggle -->
                            <Button x:Name="NexusToggleButton" Content="[ ≠ Nexus ]" Foreground="#87CEEB" FontSize="11" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"
                                    Click="NexusToggleButton_Click" ToolTip="Toggle Knowledge Nexus"/>

                            <TextBlock Text="👤" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Kegan" Foreground="#CCCCCC" FontSize="14" VerticalAlignment="Center"
                                       x:Name="UserDisplayName"/>
                            <Button x:Name="SettingsButton" Content="⚙" Foreground="#666666" FontSize="14" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                    Click="SettingsButton_Click" ToolTip="Settings"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- ═══ SCROLLING NEWS TICKER ═══ -->
                    <Border Grid.Row="1" Style="{StaticResource AsciiBox}" ClipToBounds="True">
                        <Canvas x:Name="TickerCanvas" Height="25">
                            <TextBlock x:Name="TickerText" 
                                       Text="📜 Loading quotes from journal..."
                                       Foreground="#CCCCCC" FontSize="13" FontStyle="Italic"
                                       Canvas.Top="3">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TickerTransform" X="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Border>
                    
                    <!-- ═══ KEGOMODORO + STATS ═══ -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- KEGOMODORO Widget -->
                        <Border Grid.Column="0" Style="{StaticResource AsciiBox}">
                            <StackPanel>
                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="│" Foreground="#444444"/>
                                    <TextBlock Text=" KEGOMODORO" Foreground="#888888" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <!-- Timer Display -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,5,0,10">
                                    <Image x:Name="FireImage" Width="60" Height="60" Stretch="Uniform"
                                           HorizontalAlignment="Center" Opacity="0.9"/>
                                    <TextBlock Text="25:00" Foreground="#FFFFFF" FontSize="28" FontWeight="Bold" 
                                               HorizontalAlignment="Center" Margin="0,8,0,0"
                                               FontFamily="Consolas" x:Name="TimerDisplay"/>
                                </StackPanel>
                                
                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <Button Style="{StaticResource BracketButton}" 
                                            Content="▶ Start" Foreground="#87CEEB"
                                            x:Name="StartFocusButton" Click="StartFocusButton_Click"/>
                                    <Button Style="{StaticResource BracketButton}" 
                                            Content="⚙ Customize" Margin="10,0,0,0"
                                            x:Name="CustomizeButton" Click="CustomizeButton_Click"/>
                                </StackPanel>
                                <!-- Add Manual Time -->
                                <Rectangle Height="1" Fill="#333333" Margin="10,0,10,12"/>
                                <Button Style="{StaticResource BracketButton}" 
                                        Content="⏱️ Add Manual Time" Foreground="#666666" 
                                        HorizontalAlignment="Center" FontSize="11"
                                        Click="AddManualTime_Click"/>

                                <!-- Task Widget -->
                                <comp:TaskWidget x:Name="DashboardTaskWidget" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Your Stats -->
                        <Border Grid.Column="2" x:Name="StatsBox" Style="{StaticResource AsciiBox}" 
                                Cursor="Arrow" Background="Transparent">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📊" FontSize="12"/>
                                    <TextBlock Text=" Your Stats" Foreground="#888888" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <StackPanel x:Name="TimeStatsRegion" Background="Transparent" MouseLeftButtonDown="TimeStats_Click" Cursor="Hand">
                                    <Grid Margin="0,5,0,3">
                                        <TextBlock Text="Today:" Foreground="#666666"/>
                                        <TextBlock Text="0 hrs" HorizontalAlignment="Right" Foreground="#88CC88" x:Name="TodayHours"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Week:" Foreground="#666666"/>
                                        <TextBlock Text="0 hrs" HorizontalAlignment="Right" Foreground="#88CC88" x:Name="WeekHours"/>
                                    </Grid>
                                    <Grid Margin="0,3,0,10">
                                        <TextBlock Text="Total:" Foreground="#666666"/>
                                        <TextBlock Text="0 hrs" HorizontalAlignment="Right" Foreground="#88CC88" FontWeight="Bold" x:Name="TotalHours"/>
                                    </Grid>
                                </StackPanel>

                                <!-- XP & Level -->
                                <Border x:Name="LevelRegion" Background="Transparent" Padding="8" CornerRadius="3" 
                                        MouseLeftButtonDown="LevelStats_Click" Cursor="Hand" Margin="0,5,0,10"
                                        BorderBrush="#333333" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock x:Name="UserLevelText" Text="🏆 Level 12 • 2,350 XP" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                        </Grid>
                                        <!-- ASCII Progress Bar -->
                                        <TextBlock x:Name="UserXpBar" Text="░░░░░░░░░░░░░░░░...." Foreground="#88CC88" FontSize="14" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Streak Stats -->
                                <Grid Margin="0,5,0,2">
                                    <TextBlock Text="🔥 Streak:" Foreground="#666666" FontSize="11"/>
                                    <TextBlock x:Name="CurrentStreakText" Text="7 days" HorizontalAlignment="Right" Foreground="#FFB347" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="🏅 Best:" Foreground="#666666" FontSize="11"/>
                                    <TextBlock x:Name="BestStreakText" Text="23 days" HorizontalAlignment="Right" Foreground="#AAAAAA" FontSize="11"/>
                                </Grid>
                                
                                <!-- Heatmap -->
                                <Border x:Name="HeatmapBorder" BorderBrush="#333333" BorderThickness="1" Margin="0,5,0,0" 
                                        Background="#0A0A0A" Padding="0" CornerRadius="3" Cursor="Hand">
                                    <wv2:WebView2 x:Name="PixelaHeatmapWebView" Height="80" DefaultBackgroundColor="Transparent"/>
                                </Border>
                                <TextBlock x:Name="PixelaStatus" Text="📊 Click a pixel to edit" 
                                           Foreground="#555555" FontSize="9" HorizontalAlignment="Center" 
                                           Margin="0,5,0,0"/>
                                
                                <!-- Quick Palette -->
                                <Border BorderBrush="#333333" BorderThickness="1" Margin="0,8,0,0" Padding="8,6" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="ColorGreen" Background="#70cc14" Tag="shibafu" Width="18" Height="18" Margin="2,0" BorderThickness="0" Click="PaletteColor_Click" Cursor="Hand"/>
                                        <Button x:Name="ColorRed" Background="#f3591e" Tag="momiji" Width="18" Height="18" Margin="2,0" BorderThickness="0" Click="PaletteColor_Click" Cursor="Hand"/>
                                        <Button x:Name="ColorBlue" Background="#00aced" Tag="sora" Width="18" Height="18" Margin="2,0" BorderThickness="0" Click="PaletteColor_Click" Cursor="Hand"/>
                                        <Button x:Name="ColorYellow" Background="#e4b41b" Tag="ichigyo" Width="18" Height="18" Margin="2,0" BorderThickness="0" Click="PaletteColor_Click" Cursor="Hand"/>
                                        <Button x:Name="ColorBlack" Background="#222222" Tag="kuro" Width="18" Height="18" Margin="2,0" BorderThickness="1" BorderBrush="#444444" Click="PaletteColor_Click" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- ═══ JOURNAL ═══ -->
                    <Border Grid.Row="3" Style="{StaticResource AsciiBox}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="│ What's on your mind?" Foreground="#888888" Margin="0,0,0,10"/>
                            
                            <TextBox Grid.Row="1" x:Name="JournalInput"
                                     Background="Transparent" 
                                     Foreground="#CCCCCC"
                                     BorderBrush="#333333" BorderThickness="1"
                                     Padding="10"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     CaretBrush="#CCCCCC"
                                     GotFocus="JournalInput_GotFocus"
                                     LostFocus="JournalInput_LostFocus"/>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Button Style="{StaticResource BracketButton}" 
                                        Content="💾 Save to Journal" Foreground="#AAAAAA"
                                        x:Name="SaveJournalButton" Click="SaveJournalButton_Click"/>
                                <Button Style="{StaticResource BracketButton}" 
                                        Content="📂 Open File" Foreground="#FFB347" Margin="20,0,0,0"
                                        x:Name="OpenNotepadButton" Click="OpenNotepadButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══ NEXUS PANEL (NeuralNotes) ═══ -->
                <Border Grid.Column="1" x:Name="NexusPanel" 
                        BorderBrush="#333333" BorderThickness="1,0,0,0" 
                        Margin="0,0,0,0" Width="0" ClipToBounds="True">
                    <Grid Background="#0A0A0A" Width="380">
                        <comp:NexusWidget x:Name="NeuralNexusWidget"/>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- ═══ FLOATING ASK PROMETHEUS BUTTON ═══ -->
            <Button x:Name="AskPrometheusButton" 
                    Grid.Row="1"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom"
                    Margin="0,0,25,25" Padding="0"
                    Click="AskPrometheusButton_Click" 
                    Panel.ZIndex="100"
                    Width="65" Height="65">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            
                            <!-- Glassy Border Container -->
                            <Border x:Name="PrometheusBorder"
                                    BorderBrush="#44FFFFFF" BorderThickness="1.5"
                                    CornerRadius="32.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#11FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                
                                <!-- Avatar Image with perfect circular clipping -->
                                <Ellipse Margin="3">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="pack://application:,,,/prometheus.jpg" 
                                                    Stretch="UniformToFill" 
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>

                            <!-- Subtle Inner Gloss -->
                            <Ellipse Margin="1.5" Stroke="#22FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="PrometheusBorder" Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].Color" To="#44FFFFFF" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="PrometheusBorder" Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].Color" To="#22FFFFFF" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <!-- Full-screen Celebration Overlay -->
            <comp:CelebrationOverlay x:Name="MajorCelebrationOverlay" Visibility="Collapsed" Grid.RowSpan="2"/>

            <!-- Toast Notifications Area -->
            <StackPanel x:Name="ToastContainer" 
                        Grid.RowSpan="2" 
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Center" 
                        Margin="0,50,0,0"
                        Panel.ZIndex="1000"/>
        </Grid>
    </Border>
</Window>
