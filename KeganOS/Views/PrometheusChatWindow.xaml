<Window x:Class="KeganOS.Views.PrometheusChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prometheus Terminal" 
        Height="700" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="#0C0C0C"
        Foreground="#CCCCCC"
        FontFamily="Cascadia Mono, Consolas, monospace"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Terminal colors -->
        <SolidColorBrush x:Key="TerminalGreen" Color="#00FF41"/>
        <SolidColorBrush x:Key="TerminalCyan" Color="#00D9FF"/>
        <SolidColorBrush x:Key="TerminalYellow" Color="#FFD700"/>
        <SolidColorBrush x:Key="TerminalRed" Color="#FF4444"/>
        <SolidColorBrush x:Key="TerminalMagenta" Color="#FF00FF"/>
        <SolidColorBrush x:Key="TerminalDim" Color="#666666"/>
        <SolidColorBrush x:Key="TerminalBg" Color="#0C0C0C"/>
        <SolidColorBrush x:Key="TerminalBgAlt" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TerminalBgSelected" Color="#2A2A40"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Terminal Header Bar (draggable) -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="#1A1A1A" Padding="12,8" BorderBrush="#333333" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Terminal dots (macOS style) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CloseBtn" Width="12" Height="12" Fill="#FF5F56" Margin="0,0,6,0" 
                             MouseEnter="CloseBtn_MouseEnter" MouseLeave="CloseBtn_MouseLeave"
                             MouseLeftButtonDown="CloseBtn_Click" ToolTip="Close"/>
                    <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="0,0,6,0" ToolTip="Minimize"/>
                    <Ellipse Width="12" Height="12" Fill="#27C93F" ToolTip="Maximize"/>
                </StackPanel>
                
                <!-- Center: Title with lightning bolt -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚡" Foreground="#FFD700" FontSize="12" Margin="0,0,4,0"/>
                    <TextBlock Text="prometheus" Foreground="#888888" FontSize="12"/>
                </StackPanel>
                
                <!-- Right: Mode indicator & Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackToHistoryBtn" Content="[ &lt; BACK ]" 
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Foreground="#666666" FontSize="11" FontWeight="Bold" 
                            Height="24" Margin="0,0,12,0" Padding="4,0" 
                            ToolTip="Back to History (Esc / /back)" Click="BackToHistoryBtn_Click"
                            Visibility="Collapsed"/>

                    <Button x:Name="NewChatBtn" Content="+" 
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Foreground="#00FF41" FontSize="18" FontWeight="Bold" Width="24" Height="24"
                            Margin="0,0,8,0" Padding="0,-2,0,0" 
                            ToolTip="New Chat (Ctrl+N)" Click="NewChatBtn_Click"/>
                    
                    <Button x:Name="HelpBtn" Content="?" 
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Foreground="#666666" FontSize="14" Width="24" Height="24"
                            Margin="0,0,12,0" 
                            ToolTip="Help / Commands" Click="HelpBtn_Click"/>

                    <TextBlock x:Name="ModeIndicator" Text="Chat" 
                               Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Status bar -->
        <Border x:Name="StatusBorder" Grid.Row="1" Background="#0C0C0C" Padding="12,6" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="── " Foreground="#555555"/>
                    <TextBlock Text="Prometheus (" Foreground="#888888"/>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#27C93F" Margin="2,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel" Text="Live" Foreground="#27C93F" Margin="2,0,0,0"/>
                    <TextBlock Text=")" Foreground="#888888"/>
                    <TextBlock x:Name="ConversationTitle" Text="" Foreground="#666666" Margin="8,0,0,0"/>
                </StackPanel>
                
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="" Foreground="#666666" FontSize="11"/>
            </Grid>
        </Border>
        
        <!-- Main Content Area (switches between states) -->
        <Grid Grid.Row="2" Background="#0C0C0C">
            
            <!-- State 1: Loading (Unified Splash/Loading) -->
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <!-- ASCII Logo -->
                <TextBlock FontFamily="Courier New" FontSize="6" TextAlignment="Left" HorizontalAlignment="Center" xml:space="preserve">
<Run Foreground="#00FFFF">                                                                                                                 </Run>
<Run Foreground="#00FFFF">,-.----.                                                                                                         </Run>
<Run Foreground="#00EEFF">\    /  \                               ____              ___      ,---,                                         </Run>
<Run Foreground="#00DDFF">|   :    \                            ,'  , `.          ,--.'|_  ,--.' |                                         </Run>
<Run Foreground="#00CCFF">|   |  .\ :  __  ,-.   ,---.       ,-+-,.' _ |          |  | :,' |  |  :                       ,--,              </Run>
<Run Foreground="#00BBFF">.   :  |: |,' ,'/ /|  '   ,'\   ,-+-. ;   , ||          :  : ' : :  :  :                     ,'_ /|   .--.--.    </Run>
<Run Foreground="#00AAFF">|   |   \ :'  | |' | /   /   | ,--.'|'   |  || ,---.  .;__,'  /  :  |  |,--.   ,---.    .--. |  | :  /  /    '   </Run>
<Run Foreground="#0099FF">|   : .   /|  |   ,'.   ; ,. :|   |  ,', |  |,/     \ |  |   |   |  :  '   |  /     \ ,'_ /| :  . | |  :  /`./   </Run>
<Run Foreground="#0088FF">;   | |`-' '  :  /  '   | |: :|   | /  | |--'/    /  |:__,'| :   |  |   /' : /    /  ||  ' | |  . . |  :  ;_     </Run>
<Run Foreground="#0077FF">|   | ;    |  | '   '   | .; :|   : |  | ,  .    ' / |  '  : |__ '  :  | | |.    ' / ||  | ' |  | |  \  \    `.  </Run>
<Run Foreground="#0066FF">:   ' |    ;  : |   |   :    ||   : |  |/   '   ;   /|  |  | '.'||  |  ' | :'   ;   /|:  | : ;  ; |   `----.   \ </Run>
<Run Foreground="#0055FF">:   : :    |  , ;    \   \  / |   | |`-'    '   |  / |  ;  :    ;|  :  :_:,''   |  / |'  :  `--'   \ /  /`--'  / </Run>
<Run Foreground="#0044FF">|   | :     ---'      `----'  |   ;/        |   :    |  |  ,   / |  | ,'    |   :    |:  ,      .-./'--'.     /  </Run>
<Run Foreground="#0033FF">`---'.|                       '---'          \   \  /    ---`-'  `--''       \   \  /  `--`----'      `--'---'   </Run>
<Run Foreground="#0022FF">  `---`                                       `----'                          `----'                             </Run>
<Run Foreground="#0011FF">                                                                                                                 </Run></TextBlock>
                
                <TextBlock Text="Your personal AI, grounded in your journey." 
                           Foreground="#888888" FontSize="12" TextAlignment="Center" Margin="0,20,0,0"/>

                <!-- Spinner & Status Area -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <TextBlock x:Name="LoadSpinner" Text="|" Foreground="#00D9FF" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText" Text="Consulting journey..." 
                               Foreground="#888888" FontSize="14" TextAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            
            <!-- State 3: History List -->
            <ScrollViewer x:Name="HistoryScroller" Visibility="Collapsed" 
                          VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel x:Name="HistoryPanel">
                    <!-- History items will be added dynamically -->
                </StackPanel>
            </ScrollViewer>
            
            <!-- State 4: Chat View -->
            <ScrollViewer x:Name="ChatScrollViewer" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto" Padding="15,10">
                <StackPanel x:Name="ChatPanel"/>
            </ScrollViewer>
        </Grid>
        
        <!-- Footer / Input Area -->
        <Border x:Name="FooterBorder" Grid.Row="3" Background="#1A1A1A" Padding="12" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Input Row (only visible in Chat mode) -->
                <Grid x:Name="InputRow" Grid.Row="0" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="❯" Foreground="#00FF41" FontSize="16" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <Grid Grid.Column="1">
                        <TextBox x:Name="InputBox" 
                                 Background="Transparent"
                                 Foreground="#FFFFFF"
                                 CaretBrush="#00FF41"
                                 BorderThickness="0"
                                 Padding="0,8"
                                 FontSize="14"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 VerticalContentAlignment="Center"
                                 KeyDown="InputBox_KeyDown"
                                 TextChanged="InputBox_TextChanged"/>
                        <TextBlock x:Name="PlaceholderText" 
                                   Text="Type a message, : for commands..." 
                                   Foreground="#555555"
                                   FontSize="14"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   VerticalAlignment="Center"
                                   Padding="0,8"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    
                    <TextBlock x:Name="SendHint" Grid.Column="2" 
                               Text="[Enter]" 
                               Foreground="#444444" FontSize="11" 
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                
                <!-- Hotkey hints -->
                <TextBlock x:Name="HotkeyHints" Grid.Row="1" 
                           Text="Tab: history, /new: new chat, /clear: clear, Esc: quit" 
                           Foreground="#444444" FontSize="10" Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
