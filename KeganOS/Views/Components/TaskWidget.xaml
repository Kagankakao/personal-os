<UserControl x:Class="KeganOS.Views.Components.TaskWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="250">
    <UserControl.Resources>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="TabText">
                            <Run x:Name="StartBracket" Text=" " Foreground="#444444"/>
                            <Run Text="{TemplateBinding Content}"/>
                            <Run x:Name="EndBracket" Text=" " Foreground="#444444"/>
                        </TextBlock>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="StartBracket" Property="Text" Value="["/>
                                <Setter TargetName="EndBracket" Property="Text" Value="]"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabText" Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Margin="0,10,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header Tabs -->
                <RowDefinition Height="*"/>    <!-- Task List -->
                <RowDefinition Height="Auto"/> <!-- Add Task -->
            </Grid.RowDefinitions>
            
            <!-- Header Tabs -->
            <Border Grid.Row="0" Background="#111111" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="DailyTabBtn" Content="Daily" Style="{StaticResource TabButton}" Tag="Active" Click="Tab_Click"/>
                    <TextBlock Text=" | " Foreground="#333333" VerticalAlignment="Center"/>
                    <Button x:Name="LongTermTabBtn" Content="Long Term" Style="{StaticResource TabButton}" Click="Tab_Click"/>
                    <TextBlock Text=" | " Foreground="#333333" VerticalAlignment="Center"/>
                    <Button x:Name="DoneTabBtn" Content="Done" Style="{StaticResource TabButton}" Click="Tab_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Task List -->
            <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="5">
                <ItemsControl x:Name="TasksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <CheckBox IsChecked="{Binding IsCompleted}" 
                                          Click="TaskCheckBox_Click"
                                          VerticalAlignment="Center"
                                          Margin="0,0,5,0">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <TextBlock x:Name="BoxText" Cursor="Hand">
                                                <Run Text="[" Foreground="#444444"/><Run x:Name="Mark" Text=" " Foreground="#87CEEB"/><Run Text="]" Foreground="#444444"/>
                                            </TextBlock>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Mark" Property="Text" Value="x"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                                
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#AAAAAA" 
                                           TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" 
                                        Foreground="#444444" Cursor="Hand" Click="DeleteTask_Click"
                                        FontSize="10" Margin="5,0,0,0" ToolTip="Delete Task"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Add Task -->
            <Border Grid.Row="2" BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="NewTaskInput" Background="Transparent" BorderThickness="0" 
                             Foreground="#888888" Text="[ + Add Task ]" Padding="2"
                             GotFocus="NewTaskInput_GotFocus" LostFocus="NewTaskInput_LostFocus"
                             KeyDown="NewTaskInput_KeyDown"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
