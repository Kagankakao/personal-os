<UserControl x:Class="KeganOS.Views.Components.NexusWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:comp="clr-namespace:KeganOS.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="350"
             FontFamily="Consolas" Background="#0A0A0A">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Search -->
            <RowDefinition Height="Auto"/> <!-- Tags -->
            <RowDefinition Height="*"/>    <!-- Masonry Grid -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <UniformGrid x:Name="TabHeader" Rows="1" Margin="0,0,0,15">
            <Button x:Name="TasksTabBtn" Content="TASKS" Style="{StaticResource TitleBarButton}" Click="TaskTab_Click" Foreground="#AAAAAA"/>
            <Button x:Name="NeuralTabBtn" Content="NEURAL" Style="{StaticResource TitleBarButton}" Click="NeuralTab_Click" Foreground="#87CEEB"/>
        </UniformGrid>

        <!-- Container for Content -->
        <Grid Grid.Row="1" Grid.RowSpan="4">
            <!-- Neural View -->
            <Grid x:Name="NeuralView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search -->
                    <RowDefinition Height="Auto"/> <!-- Tags -->
                    <RowDefinition Height="*"/>    <!-- Masonry Grid -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                </Grid.RowDefinitions>

                <!-- NeuralNotes Search (AI Powered) -->
                <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="8" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NexusSearchInput" Background="Transparent" BorderThickness="0" 
                                 Foreground="#CCCCCC" CaretBrush="#CCCCCC" VerticalAlignment="Center"
                                 KeyDown="NexusSearchInput_KeyDown"
                                 TextChanged="NexusSearchInput_TextChanged"/>
                        <TextBlock IsHitTestVisible="False" Text="Search or ask AI..." Foreground="#555555" 
                                   VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NexusSearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="↑" Foreground="#87CEEB" Background="Transparent" 
                                BorderThickness="0" Cursor="Hand" Click="NeuralAsk_Click"/>
                    </Grid>
                </Border>

                <!-- Tags Filter & Bulk Mode -->
                <Grid Grid.Row="1" Margin="0,10,0,15">
                    <WrapPanel x:Name="TagsPanel" Margin="0,0,80,0">
                        <!-- Dynamic Tags will be added here -->
                    </WrapPanel>

                    <Button x:Name="SelectModeBtn" Content="[ SELECT ]" Style="{StaticResource TitleBarButton}" 
                            HorizontalAlignment="Right" Foreground="#AAAAAA" Click="SelectMode_Click"/>

                    <!-- Bulk Actions Panel (Hidden by default) -->
                    <StackPanel x:Name="BulkActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button x:Name="DeleteSelectedBtn" Content="[ DELETE ]" Style="{StaticResource TitleBarButton}" 
                                Foreground="#FF6B6B" Click="DeleteSelected_Click"/>
                        <Button x:Name="CancelSelectBtn" Content="[ CANCEL ]" Style="{StaticResource TitleBarButton}" 
                                Margin="10,0,0,0" Foreground="#AAAAAA" Click="CancelSelect_Click"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                    <Grid x:Name="NotesGridContainer" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel x:Name="Column1" Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Top"/>
                        <StackPanel x:Name="Column2" Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>

                <!-- New Note Action -->
                <Button Grid.Row="3" Style="{StaticResource BracketButton}" 
                        Content="+ New Neural Note" Foreground="#AAAAAA" 
                        HorizontalAlignment="Center" Margin="0,15,0,0"
                        Click="NewNote_Click"/>
            </Grid>

            <!-- Task View -->
            <Grid x:Name="TaskView" Visibility="Collapsed">
                <comp:TaskWidget x:Name="NexusTaskWidget"/>
            </Grid>
        </Grid>

        <!-- Note Detail Panel (Overlay) -->
        <Border x:Name="NoteDetailPanel" Grid.RowSpan="5" Background="#0A0A0A" Visibility="Collapsed" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Back button -->
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- Metadata/Tags -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                    <RowDefinition Height="Auto"/> <!-- Images -->
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Button Content="[ ← Back ]" Style="{StaticResource TitleBarButton}" 
                            Click="BackToGrid_Click" 
                            Foreground="#87CEEB"/>
                    <Button x:Name="PinNoteButton" Content="[ 📌 Pin ]" Style="{StaticResource TitleBarButton}" 
                            Margin="10,0,0,0" Click="PinNote_Click" 
                            Foreground="#AAAAAA"/>
                </StackPanel>

                <TextBox x:Name="DetailTitle" Grid.Row="1" FontSize="20" FontWeight="Bold" 
                         Foreground="White" Background="Transparent" BorderThickness="0"
                         TextWrapping="Wrap" Margin="0,0,0,10" IsReadOnly="True"
                         TextChanged="OnNoteChanged"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <!-- Metadata Area -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border x:Name="CategoryBadge" Background="#1A1A1A" Padding="8,4" CornerRadius="4">
                            <TextBlock x:Name="DetailCategory" Foreground="#87CEEB" FontSize="10"/>
                        </Border>
                        <TextBlock x:Name="DetailDate" Foreground="#555555" FontSize="10" 
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tag Management -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel x:Name="DetailTagsPanel" VerticalAlignment="Center">
                            <!-- Tag chips will be rendered here -->
                        </WrapPanel>
                        <TextBox x:Name="AddTagInput" Grid.Column="1" 
                                 Background="#1A1A1A" Foreground="#888888" BorderBrush="#333333"
                                 FontSize="10" Padding="5,2" VerticalAlignment="Center"
                                 KeyDown="AddTagInput_KeyDown" ToolTip="Type and press Enter to add tag"/>
                        <TextBlock IsHitTestVisible="False" Grid.Column="1" Text="+ Add tag" 
                                   Foreground="#444444" FontSize="10" Margin="8,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AddTagInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <RichTextBox x:Name="DetailContent" Foreground="#CCCCCC" Background="Transparent" 
                                 BorderThickness="0" FontSize="14" CaretBrush="#87CEEB"
                                 AcceptsReturn="True" IsReadOnly="False"
                                 AllowDrop="True"
                                 Drop="DetailContent_Drop" 
                                 DragOver="DetailContent_DragOver"
                                 PreviewDragOver="DetailContent_DragOver">
                        <FlowDocument x:Name="DetailDocument" PagePadding="0"/>
                    </RichTextBox>
                </ScrollViewer>

                <!-- Detail Footer Actions -->
                <Button x:Name="DeleteNoteButton" Grid.Row="4" HorizontalAlignment="Right"
                        Content="[ DELETE NOTE ]" Style="{StaticResource TitleBarButton}" 
                        Foreground="#FF6B6B" Click="DeleteDetailNote_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
